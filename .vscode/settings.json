{
    "editor.fontSize": 14,
    "editor.fontWeight": "500",
    "editor.fontFamily": "'Roboto Mono', Consolas, 'Courier New', monospace",
    "editor.fontLigatures": true,
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.guides.bracketPairs": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.wordWrap": "on",
    "editor.minimap.enabled": false,
    "editor.semanticHighlighting.enabled": true,
    "editor.linkedEditing": true,
    "editor.formatOnSave": true,
    "editor.formatOnPaste": false,
    "editor.defaultFormatter": "JohnnyMorganz.stylua",
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "workbench.colorTheme": "italian-pizza",
    "workbench.iconTheme": "roblox-icons",
    "workbench.startupEditor": "none",
    "workbench.sideBar.location": "left",
    "workbench.editor.closeEmptyGroups": true,
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.fontFamily": "'Roboto Mono', monospace",
    "terminal.integrated.fontWeight": "bold",
    "terminal.integrated.cursorBlinking": true,
    "[luau]": {
        "editor.defaultFormatter": "JohnnyMorganz.stylua",
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.suggest.showKeywords": true
    },
    "[lua]": {
        "editor.defaultFormatter": "JohnnyMorganz.stylua",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.tabSize": 4
    },
    "[typescript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features",
        "editor.tabSize": 2
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.tabSize": 2
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.tabSize": 2
    },
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/node_modules": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true
    },
    "[clpp]": {
        "editor.defaultFormatter": "kartzrbx.clpp-dev"
    }
}
