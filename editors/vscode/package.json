{
  "name": "clpp-dev",
  "displayName": "CL++ (self-hosted)",
  "description": "CL++ self-hosted dialect: highlighting, snippets, diagnostics, hover, go to definition, outline, completion and formatting via clpp-boot.",
  "version": "0.1.0",
  "publisher": "kartzrbx",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "clpp",
        "aliases": [
          "CL++",
          "clpp"
        ],
        "extensions": [
          ".clp"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/clp-file.png",
          "dark": "./images/clp-file.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "clpp",
        "scopeName": "source.clpp",
        "path": "./syntaxes/clpp.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "clpp",
        "path": "./snippets/clpp.json"
      }
    ],
    "commands": [
      {
        "command": "clppDev.runFile",
        "title": "CL++ (self-hosted): Run File",
        "icon": "$(play)"
      },
      {
        "command": "clppDev.runTests",
        "title": "CL++ (self-hosted): Run Tests"
      },
      {
        "command": "clppDev.restartServer",
        "title": "CL++ (self-hosted): Restart Language Server"
      }
    ],
    "keybindings": [
      {
        "command": "clppDev.runFile",
        "key": "ctrl+f5",
        "when": "editorLangId == clpp"
      }
    ],
    "configuration": {
      "title": "CL++ (self-hosted)",
      "properties": {
        "clppDev.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to clpp-boot. Empty: use bootstrap/target/release/clpp-boot in the workspace, then clpp-boot on PATH."
        },
        "clppDev.trace": {
          "type": "boolean",
          "default": false,
          "description": "Log language server messages to the CL++ output channel."
        }
      }
    },
    "menus": {
      "editor/title/run": [
        {
          "command": "clppDev.runFile",
          "when": "resourceLangId == clpp"
        }
      ]
    }
  },
  "icon": "images/icon.png"
}
